##Option 2 re-analysis for just 50 participants for each ancestry group and Neurodev

for(i in unique(meta[n_ancestry > 50]$ancestry)){
  set.seed(25)
  
  # samples that must be retained (e.g., de novo samples)
  sample_keep <- meta[ancestry == i & s %in% dn_samples]$s
  
  # guard: if required samples alone exceed 50, sampling would fail
  if(length(sample_keep) >= 50){
    warning(paste0(i, ": ", length(sample_keep),
                   " required samples >= 50; keeping a random 50 of those"))
    ancestry_sample <- sample(x = sample_keep, size = 50)
  } else {
    ancestry_sample <- sample(x = meta[ancestry == i & !(s %in% sample_keep)]$s,
                              size = 50 - length(sample_keep))
    ancestry_sample <- c(sample_keep, ancestry_sample)
  }
  
  ancestry_sample_dt <- meta[s %in% ancestry_sample]
  meta <- rbind(meta[ancestry != i], ancestry_sample_dt, use.names = T, fill = T)
}

table(meta$ancestry)  # every group with n > 50 should now show exactly 50

