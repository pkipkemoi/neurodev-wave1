for(i in unique(meta[n_ancestry>50 & !(ancestry %in% c("South African - NeuroDev", "Kenyan - NeuroDev"))]$ancestry)){
#for(i in unique(meta[n_ancestry>50]$ancestry)){
  set.seed(25)
  sample_keep <- meta[ancestry == i & s %in% dn_samples]$s
  ancestry_sample <- sample(x=meta[ancestry == i & !(s %in% sample_keep)]$s, size=(50-length(sample_keep)))
  ancestry_sample <- c(sample_keep, ancestry_sample)
