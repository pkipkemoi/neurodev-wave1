library(Rmisc)

# LoF

lof_stats <- summarySE(meta, measurevar="lof_variant_pp", groupvars="ancestry")

lof_figure <- ggplot() +
  geom_quasirandom(data=meta, aes(x=ancestry, y=lof_variant_pp, color=ancestry)) +
  geom_point(mapping = aes(ancestry, lof_variant_pp), data = lof_stats) +
  geom_errorbar(mapping = aes(x = ancestry, ymin = lof_variant_pp-ci, ymax = lof_variant_pp+ci), 
                data = lof_stats, width = 0.2) +
  theme_classic() +
  scale_y_continuous(limits = c(0,40), breaks = c(0,10,20,30, 40)) +
  scale_color_manual(values=c("#A0CBF0", "#4782B4", "#FF60C3", "#CD78F4", "#57BEA0", "#53B74C", "#98A934", "#C99432")) +
  labs(title = "LoF", y="rare variants per proband (n)", color="ancestry") +
  theme(plot.title = element_text(hjust = 0.5, size=11, face="bold")) +
  theme(axis.title.x=element_blank(), axis.text.x=element_blank(), axis.ticks.x=element_blank()) +
  theme(legend.position = "none")

